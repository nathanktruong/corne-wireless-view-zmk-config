#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        left_parens {
            bindings = <&kp LPAR>;
            key-positions = <4 5>;
        };

        left_bracket {
            bindings = <&kp LBKT>;
            key-positions = <16 17>;
        };

        left_curly_brace {
            bindings = <&kp LBRC>;
            key-positions = <28 29>;
        };

        right_parens {
            bindings = <&kp RPAR>;
            key-positions = <6 7>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 19>;
        };

        right_curly_brace {
            bindings = <&kp RBRC>;
            key-positions = <30 31>;
        };

        escape {
            bindings = <&kp ESC>;
            key-positions = <19 20>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <21 22>;
        };

        backslash {
            bindings = <&kp LS(BACKSLASH)>;
            key-positions = <33 34>;
        };

        grave_accent {
            bindings = <&kp GRAVE>;
            key-positions = <22 23>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <34 35>;
        };

        layer_two {
            bindings = <&lt 0 SPACE>;
            key-positions = <39>;
        };

        left_control {
            bindings = <&mt LCTRL BACKSPACE>;
            key-positions = <40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T       &kp Y      &kp U     &kp I      &kp O    &kp P     &kp BSPC
&kp ESC    &kp A  &kp S  &kp D     &kp F  &kp G       &kp H      &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B       &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RET
                         &kp LALT  &mo 1  &kp LGUI    &kp SPACE  &kp BSPC  &kp RSHFT
            >;
        };

        symbols {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&kp LCTRL  &kp EXCLAMATION  &kp AT         &kp HASH   &kp DOLLAR    &kp PERCENT          &kp N7  &kp N8  &kp N9  &kp PLUS    &bt BT_SEL 0  &bt BT_CLR
&kp COLON  &kp CARET        &kp AMPERSAND  &kp ASTRK  &kp MINUS     &kp EQUAL            &kp N4  &kp N5  &kp N6  &kp MINUS   &bt BT_SEL 1  &trans
&kp LT     &kp UNDER        &kp TILDE      &kp GRAVE  &kp QUESTION  &kp DOUBLE_QUOTES    &kp N1  &kp N2  &kp N3  &kp PERIOD  &trans        &kp BSLH
                                           &trans     &trans        &kp SPACE            &trans  &kp N0  &trans
            >;
        };

        media {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &trans        &trans        &trans      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp K_MUTE  &kp C_VOL_UP  &kp C_VOL_DN  &trans      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp C_PLAY  &kp C_PREV    &kp C_NEXT    &kp C_STOP  &trans  &trans
                        &trans  &trans  &trans    &trans      &trans        &trans
            >;
        };
    };
};
